{
	"name": "dsalim.dev",
	"private": true,
	"description": "Tailwind build and tests for https://dsalim.dev (Jekyll site, deployed by GitHub Actions)",
	"scripts": {
		"build:css": "tailwindcss -i input.css -o css/style.css --minify",
		"watch:css": "tailwindcss -i input.css -o css/style.css --watch",
		"check:site": "tests/check-site.sh",
		"test": "vitest run --passWithNoTests",
		"test:watch": "vitest",
		"test:e2e": "playwright test"
	},
	"devDependencies": {
		"@playwright/test": "^1.62.1",
		"@tailwindcss/typography": "^0.5.16",
		"jsdom": "^26.1.0",
		"serve": "^14.2.4",
		"tailwindcss": "^3.4.1",
		"vitest": "^3.2.7"
	}
}
